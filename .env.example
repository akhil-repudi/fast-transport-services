# Backend Server & Database
DATABASE_PATH=./data/transport.db
BACKEND_PORT=5001
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRY_HOURS=24

# Feature Flags
ENABLE_DRIVER_ROLE=true

# Optional External Map / Traffic API (Server-side only; never exposed to client)
# Leave empty to run with seeded sample route data and honest fallback notice.
ROUTING_API_URL=
ROUTING_API_KEY=
ROUTING_API_TIMEOUT_SEC=2.5
